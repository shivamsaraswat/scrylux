# Copy to .env for local use. Never commit .env.
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=threats
DB_USER=postgres
DB_PASSWORD=change-me

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# The single login user, created/updated on startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# AI providers (optional; see docs/ai-providers.md). Leave all of these unset to run without AI, as v0.1 does.
# LLM_PROVIDER=         anthropic | openai-compatible | bedrock | gemini
# LLM_MODEL=
# LLM_BASE_URL=         openai-compatible only; https, or http for a local server with LLM_LOCAL=true
# LLM_API_KEY=         given to the worker only: the app does not use it and starts without it
# LLM_LOCAL=            true | false (openai-compatible only: your statement that it runs on your own hardware)
# LLM_REGION=           bedrock only
# EMBEDDING_PROVIDER=   openai-compatible | bedrock | gemini
# EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_LOCAL=
# EMBEDDING_REGION=
# LLM_TIMEOUT=          default 300s
# LLM_PRICE_INPUT=      US dollars per million tokens; set with LLM_PRICE_OUTPUT
# LLM_PRICE_OUTPUT=
# EMBEDDING_PRICE_INPUT=

# Background jobs and the worker (optional; see docs/install.md, "Running the worker"). The defaults are shown.
# JOB_TOKEN_CAP=            500000   the most tokens one job may use
# JOB_COST_CAP=             5        the most one job may cost, in US dollars
# JOB_MAX_RUNS=             3        1 to 5
# JOB_TIME_LIMIT=           60m      1m to 24h
# JOBS_PER_ACCOUNT=         3        queued or running at once, 1 to 100
# PROVIDER_CHECK_COOLDOWN=  5m       between one account's provider checks; 0 turns it off
# WORKER_CONCURRENCY=       1        jobs one worker runs at once
# WORKER_HEALTH_PORT=       3001     the worker's /health

# Documents (optional; see docs/install.md, "Documents and storage"). The defaults are shown.
# SOURCE_MAX_MB=                10       the largest file that may be added, 1 to 100
# SOURCES_PER_THREAT_MODEL=     20       documents in one threat model, 1 to 200
# INGESTION_JOBS_PER_ACCOUNT=   20       documents one account may have waiting or processing at once, 1 to 1000
# DOCUMENT_SPACE=               2GB      what all documents may take together (text and embeddings), 100MB to 10000GB
# SOURCE_MAX_CHARS=             1000000  the most text one document may hold, 1000 to 10000000 (worker)
# EXTRACT_TIME_LIMIT=           120s     the most time reading one file may take, 10s to 30m (worker)
# EXTRACT_MEMORY_MB=            1024     the most memory reading one file may use, 128 to 8192 (worker)
# EXTRACT_UNPACKED_MB=          50       the most a Word file's parts may unpack to, 1 to 1000 (worker)
# EXTRACT_MAX_PAGES=            2000     the most pages of one PDF, 1 to 100000 (worker)
# Where the files that are being processed are kept, for the app and the worker alike.
# STORAGE_BACKEND=              local    local | s3
# STORAGE_DIR=                  storage  local only: a directory the app and the worker can both write
# STORAGE_S3_BUCKET=            s3 only; a dedicated bucket, or a dedicated prefix of one
# STORAGE_S3_PREFIX=            scrylux/ s3 only
# STORAGE_S3_REGION=            s3 only
# STORAGE_S3_ENDPOINT=          s3 only: an https:// address, for a service other than AWS S3
# STORAGE_S3_FORCE_PATH_STYLE=  false    s3 only: true for services that need path-style addresses
# These two are secrets. Without them the AWS SDK's default chain is used (the instance or task role). Give both or neither.
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
