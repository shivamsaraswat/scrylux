{
  "name": "@specter/api",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --conditions=@specter/source src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate": "tsx --conditions=@specter/source src/migrate.ts",
    "openapi": "tsx --conditions=@specter/source src/v1/openapi.ts",
    "formats": "tsx --conditions=@specter/source src/exchange/schema.ts",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1149.0",
    "@specter/core": "workspace:*",
    "@specter/db": "workspace:*",
    "@specter/threat-library": "workspace:*",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0"
  }
}
