{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scrylux-file-v1.schema.json",
  "title": "Scrylux file, format version 1",
  "description": "One threat model with its diagram, threats and mitigations, exported by Scrylux and importable into any Scrylux install.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "scrylux"
    },
    "format_version": {
      "type": "number",
      "const": 1
    },
    "exported_at": {
      "type": "string",
      "description": "When the file was exported (ISO 8601, UTC). Ignored on import."
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "The project the model was exported from, for information. Ignored on import."
    },
    "threat_model": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "methodology": {
          "type": "string",
          "enum": [
            "STRIDE"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved"
          ]
        }
      },
      "required": [
        "name",
        "methodology",
        "status"
      ],
      "additionalProperties": false
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Any string; unique across the file. An import gives every record a new id."
          },
          "type": {
            "type": "string",
            "enum": [
              "external_entity",
              "process",
              "data_store",
              "data_flow",
              "trust_boundary"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "properties": {
            "type": "object",
            "properties": {
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "flags": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "boolean"
                }
              }
            },
            "additionalProperties": false,
            "description": "Technology tags and security flags. A flag that is absent means \"not assessed\"; false means \"no\". The flags allowed depend on the element type."
          },
          "layout": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "null (never placed, and always for a data flow), { x, y } for a node, or { x, y, width, height } for a trust boundary. x and y are relative to the parent boundary, or to the diagram origin when there is none."
          },
          "parent_boundary_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "description": "Any string; unique across the file. An import gives every record a new id."
              },
              {
                "type": "null"
              }
            ]
          },
          "source_element_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "description": "Any string; unique across the file. An import gives every record a new id."
              },
              {
                "type": "null"
              }
            ]
          },
          "target_element_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "description": "Any string; unique across the file. An import gives every record a new id."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "type",
          "name",
          "properties",
          "layout",
          "parent_boundary_id",
          "source_element_id",
          "target_element_id"
        ],
        "additionalProperties": false
      }
    },
    "threats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Any string; unique across the file. An import gives every record a new id."
          },
          "element_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "description": "Any string; unique across the file. An import gives every record a new id."
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "Spoofing",
              "Tampering",
              "Repudiation",
              "Information Disclosure",
              "Denial of Service",
              "Elevation of Privilege"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "likelihood": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "High"
            ]
          },
          "impact": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "High"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "mitigated",
              "accepted",
              "not_applicable"
            ]
          },
          "status_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "type": "string",
            "enum": [
              "manual",
              "rule",
              "ai"
            ]
          },
          "library_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "stale": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "reason": {
                        "type": "string",
                        "const": "conditions_unmet"
                      },
                      "unmet": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "fact": {
                                  "type": "string",
                                  "const": "element_type"
                                },
                                "required": {
                                  "type": "string",
                                  "enum": [
                                    "external_entity",
                                    "process",
                                    "data_store",
                                    "data_flow"
                                  ]
                                },
                                "actual": {
                                  "type": "string",
                                  "enum": [
                                    "external_entity",
                                    "process",
                                    "data_store",
                                    "data_flow",
                                    "trust_boundary"
                                  ]
                                }
                              },
                              "required": [
                                "fact",
                                "required",
                                "actual"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "fact": {
                                  "type": "string",
                                  "const": "flag"
                                },
                                "flag": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "required": {
                                  "type": "string",
                                  "enum": [
                                    "yes",
                                    "no"
                                  ]
                                },
                                "actual": {
                                  "type": "string",
                                  "enum": [
                                    "yes",
                                    "no",
                                    "not_assessed"
                                  ]
                                }
                              },
                              "required": [
                                "fact",
                                "flag",
                                "required",
                                "actual"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "fact": {
                                  "type": "string",
                                  "const": "crosses_trust_boundary"
                                },
                                "required": {
                                  "type": "string",
                                  "enum": [
                                    "yes",
                                    "no"
                                  ]
                                },
                                "actual": {
                                  "type": "string",
                                  "enum": [
                                    "yes",
                                    "no"
                                  ]
                                }
                              },
                              "required": [
                                "fact",
                                "required",
                                "actual"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "fact": {
                                  "type": "string",
                                  "enum": [
                                    "source_type",
                                    "target_type"
                                  ]
                                },
                                "required": {
                                  "type": "string",
                                  "enum": [
                                    "external_entity",
                                    "process",
                                    "data_store"
                                  ]
                                },
                                "actual": {
                                  "type": "string",
                                  "enum": [
                                    "external_entity",
                                    "process",
                                    "data_store"
                                  ]
                                }
                              },
                              "required": [
                                "fact",
                                "required",
                                "actual"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        }
                      }
                    },
                    "required": [
                      "reason",
                      "unmet"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "reason": {
                        "type": "string",
                        "const": "rule_retired"
                      },
                      "retired_on": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "retirement_reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "replaced_by": {
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "reason",
                      "retired_on",
                      "retirement_reason",
                      "replaced_by"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "reason": {
                        "type": "string",
                        "const": "rule_unknown"
                      }
                    },
                    "required": [
                      "reason"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "element_id",
          "category",
          "title",
          "description",
          "likelihood",
          "impact",
          "status",
          "status_reason",
          "origin",
          "library_ref",
          "stale"
        ],
        "additionalProperties": false
      }
    },
    "mitigations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Any string; unique across the file. An import gives every record a new id."
          },
          "threat_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Any string; unique across the file. An import gives every record a new id."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "implemented",
              "verified"
            ]
          },
          "external_ref": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^[hH][tT][tT][pP][sS]?://\\S+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "threat_id",
          "description",
          "status",
          "external_ref"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "format_version",
    "exported_at",
    "project",
    "threat_model",
    "elements",
    "threats",
    "mitigations"
  ],
  "additionalProperties": false
}
