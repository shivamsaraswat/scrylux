{
  "name": "scrylux",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p scripts",
    "lint": "pnpm -r run lint && eslint scripts && tsx scripts/check-licenses.ts",
    "test": "pnpm -r run test && vitest run --root scripts",
    "build": "pnpm -r run build",
    "test:e2e": "pnpm --filter @scrylux/web test:e2e"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0",
    "eslint": "^10.14.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "typescript-eslint": "^8.72.1",
    "prettier": "^3.9.10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "31.0.0",
    "yaml": "2.9.1"
  }
}
